# Unofficial Linux port of Lian Li L-Connect 3, built from a local clone of the repository. Not in the AUR: the
# sources are derived from Lian Li's software, so this is meant for building on your own machine.
#
# Build:
#   cd packaging/arch && LCONNECT_SRC=/path/to/lconnect-linux makepkg -si
# (LCONNECT_SRC defaults to the repository this PKGBUILD lives in.)

pkgname=lconnect-linux
pkgver=2.0.11
pkgrel=1
pkgdesc="Lian Li L-Connect 3 port: UNI FAN TL / TL LCD / SL Infinity fan speed, RGB and LCD control"
arch=('x86_64')
url="https://github.com/koenhendriks/lian-li-lconnect-linux"
license=('LicenseRef-L-Connect-derived')
depends=('dotnet-runtime-10.0' 'aspnet-runtime-10.0' 'hidapi' 'ffmpeg' 'systemd' 'fontconfig' 'libx11' 'libice' 'libsm')
makedepends=('dotnet-sdk-10.0' 'aspnet-targeting-pack-10.0' 'git')
optdepends=('chromium: render LCD sensor screens (CPU/GPU temperature and load gauges)'
            'nvidia-utils: NVIDIA GPU temperature/load for fan curves and sensor screens')
options=('!strip' '!debug')
install=lconnect.install
backup=()
source=("lconnect-linux::git+file://${LCONNECT_SRC:-$(realpath "$startdir/../..")}")
sha256sums=('SKIP')

pkgver() {
	cd lconnect-linux
	printf "2.0.11.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd lconnect-linux
	export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
	local project
	for project in LConnect.Daemon LConnect.Cli LConnect.Ui; do
		dotnet publish "src/$project" -c Release -r linux-x64 --self-contained false \
			-p:DebugType=None -p:GenerateDocumentationFile=false -o "$srcdir/publish"
	done
}

check() {
	cd lconnect-linux
	export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
	dotnet test tests/LConnect.Core.Tests -c Release
}

package() {
	cd lconnect-linux
	local pk="$srcdir/lconnect-linux/packaging/arch"

	install -dm755 "$pkgdir/usr/lib/lconnect"
	cp -a "$srcdir/publish/." "$pkgdir/usr/lib/lconnect/"
	chmod 755 "$pkgdir/usr/lib/lconnect"
	chmod 755 "$pkgdir/usr/lib/lconnect/lconnectd" "$pkgdir/usr/lib/lconnect/lconnectctl" "$pkgdir/usr/lib/lconnect/lconnect-ui"

	install -dm755 "$pkgdir/usr/bin"
	ln -s /usr/lib/lconnect/lconnectctl "$pkgdir/usr/bin/lconnectctl"
	ln -s /usr/lib/lconnect/lconnect-ui "$pkgdir/usr/bin/lconnect-ui"

	install -Dm644 "$pk/lconnectd.service" "$pkgdir/usr/lib/systemd/system/lconnectd.service"
	install -Dm644 "$pk/lconnect.sysusers" "$pkgdir/usr/lib/sysusers.d/lconnect.conf"
	install -Dm644 "$pk/lconnect.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/lconnect.conf"
	install -Dm644 "$pk/60-lconnect.rules" "$pkgdir/usr/lib/udev/rules.d/60-lconnect.rules"
	install -Dm755 "$pk/lconnect.sleep" "$pkgdir/usr/lib/systemd/system-sleep/lconnect"
	install -Dm644 "$pk/lconnect-ui.desktop" "$pkgdir/usr/share/applications/lconnect-ui.desktop"
	install -Dm644 "$pk/lconnect-ui-autostart.desktop" "$pkgdir/etc/xdg/autostart/lconnect-ui.desktop"
	install -Dm644 README.md "$pkgdir/usr/share/doc/lconnect-linux/README.md"
}
