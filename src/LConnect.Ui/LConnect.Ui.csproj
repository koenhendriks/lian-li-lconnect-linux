<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop GUI (Avalonia) for the L-Connect 3 Linux port. Talks to lconnectd through the LConnect.App layer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>lconnect-ui</AssemblyName>
    <RootNamespace>LConnectUi</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CA1416;CS4014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LConnect.Core\LConnect.Core.csproj" />
    <ProjectReference Include="..\LConnect.App\LConnect.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LConnect.Ui.Tests" />
  </ItemGroup>
</Project>
