<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LConnectUi.ViewModels"
        x:Class="LConnectUi.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="L-Connect"
        Width="1280" Height="860" MinWidth="960" MinHeight="620"
        Background="{DynamicResource AppBackground}">
  <Grid ColumnDefinitions="224,*">
    <Border Background="{DynamicResource NavBackground}">
      <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,10,8,22" Spacing="12">
          <PathIcon Data="{StaticResource Icon.Fan}" Width="30" Height="30" Foreground="{StaticResource AccentBrushLocal}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="L-Connect" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Linux port" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="10,8">
          <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                   Fill="{Binding DaemonReachable, Converter={StaticResource ReachableBrushConverter}}" />
          <TextBlock Text="{Binding DaemonStatusText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{Binding IconKey, Converter={StaticResource IconConverter}}" Width="18" Height="18" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
