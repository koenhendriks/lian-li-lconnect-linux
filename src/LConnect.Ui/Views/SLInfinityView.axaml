<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LConnectUi.ViewModels"
             xmlns:v="using:LConnectUi.Views"
             xmlns:svc="using:LConnectUi.Services"
             x:Class="LConnectUi.Views.SLInfinityView"
             x:DataType="vm:SLInfinityViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,24" Spacing="16">
      <DockPanel>
        <ComboBox DockPanel.Dock="Right" MinWidth="180" ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}"
                  IsVisible="{Binding MultipleControllers}" />
        <TextBlock Classes="h1" Text="{Binding Title}" />
      </DockPanel>

      <Border Classes="hint" IsVisible="{Binding !HasController}">
        <TextBlock Text="{Binding NoDeviceHint}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="16" IsVisible="{Binding HasController}">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Groups" Margin="0" />
            <ListBox Classes="chips" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SLGroupItem">
                  <StackPanel Spacing="2" MinWidth="180">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="12" Text="{Binding RpmText}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Classes="label" FontSize="11" Text="{Binding ModeText}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                    <TextBlock Classes="label" FontSize="11">
                      <Run Text="{Binding FansText}" /><Run Text=" · " /><Run Text="{Binding ProfileText}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="{svc:Tr I18n.Text.QuantityOfFans, 'Quantity of fans'}" />
              <NumericUpDown Minimum="0" Maximum="4" Increment="1" FormatString="0" Width="120" Value="{Binding FanQuantity}" />
              <Button Content="{svc:Tr I18n.Text.Apply, 'Apply'}" Command="{Binding ApplyFanQuantityCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,16,*">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="{svc:Tr I18n.Text.LightingEffects, 'Lighting'}" Margin="0" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Ring" />
                <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" />
                <TextBlock Grid.Row="1" Classes="label" Text="{svc:Tr I18n.Text.EffectMode, 'Effect'}" Margin="0,10,0,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" MinWidth="240" MaxDropDownHeight="720"
                          ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" IsChecked="{Binding IsMerged}" IsVisible="{Binding IsMergeAvailable}"
                          Content="{svc:Tr I18n.Text.Merge, 'Merge across all groups'}" />
              </Grid>
              <Separator />
              <v:LightingEditorView DataContext="{Binding Editor}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{svc:Tr I18n.Text.Apply, 'Apply'}" Command="{Binding ApplyLightingCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="{svc:Tr I18n.Text.ApplyToAll, 'Apply To All'}" Command="{Binding ApplyLightingToAllCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="{svc:Tr I18n.Text.Default, 'Default'}" Command="{Binding ResetLightingCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" Grid.Column="2" VerticalAlignment="Top">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="{svc:Tr I18n.Text.FanSpeed, 'Fan speed'}" Margin="0" />
              <v:RpmCurveView DataContext="{Binding Curve}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{svc:Tr I18n.Text.Apply, 'Apply'}" Command="{Binding ApplyFanCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="{svc:Tr I18n.Text.ApplyToAll, 'Apply To All'}" Command="{Binding ApplyFanToAllCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="{svc:Tr I18n.Text.Default, 'Default'}" Command="{Binding ResetFanCommand}" IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{Binding StatusIsError, Converter={StaticResource StatusBrushConverter}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
