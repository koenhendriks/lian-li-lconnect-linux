    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LConnect.Core\LConnect.Core.csproj" />
    <ProjectReference Include="..\..\src\LConnect.App\LConnect.App.csproj" />
    <ProjectReference Include="..\..\src\LConnect.Ui\LConnect.Ui.csproj" />
  </ItemGroup>
</Project>
