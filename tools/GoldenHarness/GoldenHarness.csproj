<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the shared golden scenarios against the ORIGINAL L-Connect 3 assemblies (Windows only). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <LConnectDir Condition="'$(LConnectDir)' == ''">C:\Program Files\Lian-Li\L-Connect 3</LConnectDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\tests\Golden\*.cs" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Configuration" />
    <Reference Include="L-Connect.Core"><HintPath>$(LConnectDir)\L-Connect.Core.dll</HintPath></Reference>
    <Reference Include="L-Connect-Service"><HintPath>$(LConnectDir)\L-Connect-Service.exe</HintPath></Reference>
    <Reference Include="System.Text.Json"><HintPath>$(LConnectDir)\System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Memory"><HintPath>$(LConnectDir)\System.Memory.dll</HintPath></Reference>
  </ItemGroup>
</Project>
